# Normalize text in Git; avoid platform-dependent firmware/script diffs.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.S text eol=lf
*.s text eol=lf
*.ld text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.bin binary
*.OSC binary
*.wav binary
